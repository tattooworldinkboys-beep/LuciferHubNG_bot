
const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;
const TOKEN = process.env.TELEGRAM_BOT_TOKEN;

app.get("/", (req, res) => {
  res.send("ŁỮĆƗ₣€Ř Bot service is running.");
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`Web server listening on port ${PORT}`);
});

async function telegram(method, body = {}) {
  const response = await fetch(
    `https://api.telegram.org/bot${TOKEN}/${method}`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    }
  );

  const data = await response.json();

  if (!data.ok) {
    throw new Error(data.description || "Telegram API request failed");
  }

  return data.result;
}

async function handleUpdate(update) {
  const message = update.message;
  if (!message || !message.text) return;

  const chatId = message.chat.id;
  const input = message.text.trim();
  const command = input.split(/\s+/)[0].split("@")[0].toLowerCase();

  let reply;

  switch (command) {
    case "/start":
      reply =
        "🔥 Welcome to ŁỮĆƗ₣€Ř!\n\n" +
        "Your personal Telegram bot is here.\n\n" +
        "Choose a command:\n" +
        "/help — Show commands\n" +
        "/status — Check bot status";
      break;

    case "/help":
      reply =
        "📜 ŁỮĆƗ₣€Ř Commands\n\n" +
        "/start — Start the bot\n" +
        "/help — Show this help\n" +
        "/status — Check bot status";
      break;

    case "/status":
      reply = "✅ ŁỮĆƗ₣€Ř is online and responding.";
      break;

    default:
      reply =
        "I received your message. More features are coming.\n\n" +
        "Send /help to see available commands.";
  }

  await telegram("sendMessage", {
    chat_id: chatId,
    text: reply
  });
}

async function startPolling() {
  if (!TOKEN) {
    console.error("Missing TELEGRAM_BOT_TOKEN environment variable.");
    process.exit(1);
  }

  let offset = 0;

  console.log("Starting Telegram long polling...");

  while (true) {
    try {
      const updates = await telegram("getUpdates", {
        offset,
        timeout: 30,
        allowed_updates: ["message"]
      });

      for (const update of updates) {
        offset = update.update_id + 1;

        try {
          await handleUpdate(update);
        } catch (error) {
          console.error("Could not process update:", error.message);
        }
      }
    } catch (error) {
      console.error("Telegram polling error:", error.message);
      await new Promise(resolve => setTimeout(resolve, 5000));
    }
  }
}

startPolling();
